# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---- TypeMe production auth (Supabase + real OTP backend) ----
# Frontend-safe (bundled into the JS, public by definition):
# REQUIRED: Supabase project URL + anon key. Enables real sessions,
# RLS-backed storage, and multi-device sync. Until set, the app runs in
# local demo mode (localStorage only).
VITE_SUPABASE_URL="https://rifdeflmatwsyvexevgs.supabase.co"
VITE_SUPABASE_ANON_KEY=""

# Demo phone login. Active automatically in `vite dev`. For preview/prod
# builds set "true" ONLY for UI testing — real users must use the backend.
# When demo is off and no backend exists, phone login shows "unavailable"
# instead of faking authentication.
VITE_DEMO_AUTH="false"

# Controlled test accounts (DEV builds only, comma-separated national
# digits — CODES ARE NEVER HERE, they live in the Edge Function env).
# Empty (default, and always in production builds) routes every number to
# native Supabase SMS auth.
VITE_TEST_NUMBERS=""
# Deployed bridge URL, e.g.
# https://rifdeflmatwsyvexevgs.supabase.co/functions/v1/verify-test-otp
# Unset until `supabase functions deploy verify-test-otp` is done.
VITE_TEST_AUTH_URL=""
# Explicit pre-deploy stand-in (LOCAL DEV ONLY, default off): "true" keeps
# the in-memory OTP simulator until the bridge above is deployed. Sessions
# stay anonymous and are NOT phone-bound; the app badges this on screen.
# Never set in committed/shared env files. Delete once the bridge is live.
VITE_ALLOW_DEV_SIMULATED_OTP="false"

# Server-only (NEVER prefix with VITE_, never commit real values):
# REQUIRED: Supabase service-role key (backend only) for admin/mint flows.
SUPABASE_SERVICE_ROLE_KEY=""
# REQUIRED: OTP provider credentials (MSG91 / Twilio / 2Factor / Exotel —
# whichever is configured). The browser must never see these.
OTP_PROVIDER="MSG91"
OTP_PROVIDER_API_KEY=""
OTP_PROVIDER_SENDER_ID=""
OTP_PROVIDER_TEMPLATE_ID=""
# India DLT registration required by most Indian SMS providers (server-side).
DLT_ENTITY_ID=""
DLT_TEMPLATE_ID=""
